{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "仅编译当前文件",
      "type": "shell",
      "command": "mkdir -p '${workspaceFolder}/build' && g++ -std=c++17 -Wall -O2 -g -I/usr/include/eigen3 '${file}' -o '${workspaceFolder}/build/${fileBasenameNoExtension}'",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "编译并运行当前文件",
      "type": "shell",
      "command": "mkdir -p '${workspaceFolder}/build' && g++ -std=c++17 -Wall -O2 -g -I/usr/include/eigen3 '${file}' -o '${workspaceFolder}/build/${fileBasenameNoExtension}' && echo '--- 运行结果 ---' && '${workspaceFolder}/build/${fileBasenameNoExtension}'",
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "清理编译产物",
      "type": "shell",
      "command": "rm -rf '${workspaceFolder}/build' && echo '已清理 build/'",
      "problemMatcher": []
    }
  ]
}
